# Learning Platform: environment variables. Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.

# --- Tutor model (Azure OpenAI) ---
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Optional: a different deployment for the tutor itself (default: AZURE_OPENAI_DEPLOYMENT).
# AZURE_OPENAI_AUTHOR_DEPLOYMENT=gpt-4.1
# Optional, for scripts/lesson_eval.py --judge only: judge the tutor's facts with a stronger model, which may be on another
# Azure resource (all three; default: the tutor's own model).
# JUDGE_AZURE_OPENAI_ENDPOINT=https://your-other-resource.openai.azure.com/
# JUDGE_AZURE_OPENAI_API_KEY=your_key_here
# JUDGE_AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Spoken explanations (ElevenLabs). Without a key the tutor still works, with silent audio ---
ELEVENLABS_API_KEY=your_key_here
# Optional: override the default voice (Rachel = 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Voice input (Deepgram). Optional: dictation is disabled without it ---
# DEEPGRAM_API_KEY=your_key_here

# --- Database ---
# Postgres: a dedicated database for this app (tests use <name>_test automatically).
# Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql://user:pass@localhost:5432/learning_platform
# Optional: point the test suite at a specific throwaway database
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/learning_platform_test

# --- Optional tuning ---
# LP_VOICE=0 turns the tutor's voice off on purpose (test runs: no ElevenLabs credits are spent).
# LP_VOICE=0
# Extra browser origins allowed to call the API (any localhost port is always allowed). Comma separated.
# CORS_ORIGINS=https://tutor.example.com
# Requests per minute: chat is limited per notebook, voice per client address.
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_VOICE_PER_MIN=30
# Longest single live-dictation session in seconds (Deepgram bills by audio time).
# MAX_VOICE_SECONDS=300
